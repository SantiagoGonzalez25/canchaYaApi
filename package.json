{
  "name": "canchayaapi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:lan": "next dev -H 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=.env scripts/seed.mts",
    "seed:demo": "tsx --env-file=.env scripts/seed.mts --demo --reset",
    "set-role": "tsx --env-file=.env scripts/set-role.mts",
    "create-user": "tsx --env-file=.env scripts/create-user.mts"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "highcharts": "^12.6.2",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.6"
}
