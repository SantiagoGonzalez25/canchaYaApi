# Copia este archivo a .env y completa los valores.
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Entre comillas dobles y con los saltos de línea escritos como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Firebase Console → Configuración del proyecto → General → Clave de API web
FIREBASE_WEB_API_KEY=AIza...
# Opcional: bucket de Storage. Si se omite, se usa <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
